{
  "name": "dpdpa-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev && tsx scripts/apply-rls.ts",
    "db:rls": "tsx scripts/apply-rls.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev && tsx scripts/apply-rls.ts && tsx prisma/seed.ts",
    "test:isolation": "tsx scripts/test-isolation.ts",
    "test:consent": "tsx tests/consent.test.ts && tsx tests/consent-service.test.ts && tsx tests/cm-readiness.test.ts",
    "test:consent-isolation": "tsx scripts/test-consent-isolation.ts",
    "test:email": "tsx tests/email.test.ts",
    "test:departments": "node --import tsx tests/departments.test.ts",
    "test:department-isolation": "node --import tsx scripts/test-department-isolation.ts",
    "db:demo": "node --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "docx": "^9.13.0",
    "dotenv": "^16.4.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "next": "^16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7",
    "smtp-mailer": "npm:nodemailer@10.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "license": "Apache-2.0"
}
