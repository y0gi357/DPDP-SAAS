# App connection: low-privilege role, subject to row-level security
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/dpdpa"
# Owner connection: used ONLY for migrations, RLS setup and seeding
DIRECT_URL="postgresql://dpdpa_owner:owner_password@localhost:5432/dpdpa"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public address of the app, used in the links inside emails (no trailing slash)
APP_URL="http://localhost:3000"
# Outgoing mail through any SMTP provider, e.g. smtps://user:password@smtp.example.com:465
# Leave empty in development: emails are printed to the terminal instead.
SMTP_URL=""
EMAIL_FROM="DPDPA Platform <no-reply@example.com>"
# Set to "false" to stop strangers creating organisations (people then join by invitation only)
ALLOW_SIGNUP="true"

# Optional: path to a reviewed controls library JSON (same shape as data/controls-v1.1.json)
# CONTROLS_FILE="data/controls-v1.1.json"
